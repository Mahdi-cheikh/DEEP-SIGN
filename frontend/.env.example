# Copy this file to .env.local for local development.
# In production (Vercel), set these as Environment Variables on the project.

# Project URL — Supabase Dashboard → Project Settings → API → "Project URL"
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Anon public key — Supabase Dashboard → Project Settings → API → "Project API keys" → anon public
# This key is safe to expose in the browser; row-level-security policies protect the data.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
