# DEEP-SIGN backend configuration
# Copy this file to .env and edit the values.

# Secret used to sign JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Access-token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite database URL (default), can be swapped for Postgres/MySQL
DATABASE_URL=sqlite:///./deepsign.db

# Comma-separated list of allowed CORS origins for the React frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minimum confidence (0-1) below which a detection is reported as "unknown"
MIN_CONFIDENCE=0.55
